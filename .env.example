# Supabase transaction pooler URL (port 6543) for the Next.js runtime.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:6543/postgres

# Supabase direct or session pooler URL (port 5432) for Drizzle migrations.
DIRECT_URL=postgresql://postgres:YOUR_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# Browser-safe Supabase project URL. HTTP and HTTPS URLs are supported.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co

# Browser-safe Supabase publishable Auth/API key. This is not a service-role secret.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
